APP_ENV=development

# ─────────────────────────────────────────────

# Database ← PICK ONE OPTION BELOW

# ─────────────────────────────────────────────

# OPTION A — SQLite (local dev, zero setup, no database needed)

# Comment out DATABASE_URL entirely — the app auto-creates data/pilot.db

# DATABASE_URL=

# OPTION B — Supabase Postgres (recommended for demo/production)

# Paste your connection string from: Supabase → Project Settings → Database → URI

# Format: postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres

# NOTE: Replace [YOUR-PASSWORD] with your actual Supabase database password.

# (If your password contains special characters like @, encode it: @ -> %40)

DATABASE_URL=postgresql+psycopg://postgres.xtowjzwlxjceapfecila:985beO4j0ETDYZgn@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────

# Supabase (for Auth / Realtime — not required for basic RAG)

# ─────────────────────────────────────────────

SUPABASE_URL=https://xtowjzwlxjceapfecila.supabase.co

SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh0b3dqendseGpjZWFwZmVjaWxhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwMjIwNzIsImV4cCI6MjEwNDU5ODA3Mn0.SO9BUpQToQwjseeirazkrpCvy8Y--8tnUlfhQlvPz9A

# ─────────────────────────────────────────────

# Session / Security

# ─────────────────────────────────────────────

SESSION_SECRET=a9190f2cdadb143a244ddecbb28835de0f41c6772382e22e4515ccc72e231433

PUBLIC_ORIGIN=http://localhost:5173

COOKIE_SECURE=false

STORAGE_DIR=

CORPUS_MANIFEST=

# ─────────────────────────────────────────────

# Generation Provider: groq | gemini | ollama | none

# ─────────────────────────────────────────────

GENERATION_PROVIDER=groq

# Groq — get a free key at https://console.groq.com

GROQ_API_KEY=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

GROQ_MODEL=openai/gpt-oss-20b

# ─────────────────────────────────────────────

# Ingestion (LlamaParse)

# Get a free key at https://cloud.llamaindex.ai

# ─────────────────────────────────────────────

LLAMA_CLOUD_API_KEY=llx-7iEeeql63bl5687aSVJMNVWYgHseyvR64avtVx14FISLbiZy

# ─────────────────────────────────────────────

# Embeddings (local sentence-transformers model)

# ─────────────────────────────────────────────

EMBEDDINGS_ENABLED=true

INCLUDE_MODELS=true

REFERENCE_SYNTHESIS_ENABLED=true

EMBEDDING_MODEL=intfloat/multilingual-e5-small

EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# ─────────────────────────────────────────────

# Bhashini (Translation API)

# ─────────────────────────────────────────────

BHASHINI_USER_ID=

BHASHINI_API_KEY=

BHASHINI_PIPELINE_ID=

BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ─────────────────────────────────────────────

# Admin / Retention

# ─────────────────────────────────────────────

ADMIN_EMAIL=admin@gmail.com

ADMIN_PASSWORD=admin12345678

GUEST_RETENTION_HOURS=24

CASE_RETENTION_DAYS=90

AUDIT_RETENTION_DAYS=365

MAX_UPLOAD_MB=15

DAILY_REQUEST_LIMIT=100

REQUESTS_PER_MINUTE=20

SOURCE_STALE_DAYS=30

 
