APP_ENV=development

# ─────────────────────────────────────────────
# Database
# For local dev: leave as SQLite (default).
# For Supabase: paste your Supabase Postgres connection string below.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://ipsakti:change-this-password@db:5432/ipsakti
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

POSTGRES_PASSWORD=change-this-password

# ─────────────────────────────────────────────
# Supabase (for Auth / Realtime features — not required for basic RAG)
# ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────
# Session / Security
# ─────────────────────────────────────────────
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
STORAGE_DIR=/app/data
CORPUS_MANIFEST=/app/corpus/manifest.json

# ─────────────────────────────────────────────
# Generation Provider: groq | gemini | ollama | none
# ─────────────────────────────────────────────
GENERATION_PROVIDER=groq

# Groq — get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# ─────────────────────────────────────────────
# Ingestion (LlamaParse)
# PDF → Markdown extraction via cloud API (handles OCR, tables, Devanagari)
# Get a free key at https://cloud.llamaindex.ai
# ─────────────────────────────────────────────
LLAMA_CLOUD_API_KEY=

# ─────────────────────────────────────────────
# Embeddings (local sentence-transformers — Groq has no embeddings API)
# ─────────────────────────────────────────────
EMBEDDINGS_ENABLED=true
INCLUDE_MODELS=true
REFERENCE_SYNTHESIS_ENABLED=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# ─────────────────────────────────────────────
# Bhashini (Translation)
# ─────────────────────────────────────────────
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# ─────────────────────────────────────────────
# Admin / Retention
# ─────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
GUEST_RETENTION_HOURS=24
CASE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
MAX_UPLOAD_MB=15
DAILY_REQUEST_LIMIT=100
REQUESTS_PER_MINUTE=20
SOURCE_STALE_DAYS=30
